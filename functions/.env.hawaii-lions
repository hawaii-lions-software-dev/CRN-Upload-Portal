# Non-secret config for sendCrnConfirmation (project hawaii-lions). Safe to commit.
# The AWS access key lives in Secret Manager: firebase functions:secrets:set AWS_SES_ACCESS_KEY_ID / AWS_SES_SECRET_ACCESS_KEY
SES_REGION=us-east-1
SES_CONFIGURATION_SET=crn-transactional
CRN_FROM_ADDRESS=informationtechnology@hawaiilions.org
# Optional; defaults to informationtechnology@hawaiilions.org
# CRN_REPLY_TO=informationtechnology@hawaiilions.org
CRN_REPLY_TO=informationtechnology@hawaiilions.org
